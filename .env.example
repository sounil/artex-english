# Docker deployment settings (copy this file to .env)
# ARTEX_IMAGE is the image docker-compose runs. Empty means artex-global:local, built from this checkout
# (see the Dockerfile header). To run a published release instead, name an image from a registry you control.
ARTEX_IMAGE=
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (fill in one or both. You can also leave them empty and configure later in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# First-run protection (prevents remote takeover of the admin account)
# - By default the web/API port is published only on the host's 127.0.0.1. If other devices
#   need to connect directly, change ARTEX_BIND=0.0.0.0, but finish initial setup first.
# - On first start a random setup token is printed to the logs (docker compose logs artex),
#   and you must enter it on the /setup screen to create the admin password.
#   If ARTEX_SETUP_TOKEN is set, that value becomes the token and is not printed to the logs.
# - If ARTEX_ADMIN_PASSWORD is set, it initializes with that value directly, skipping /setup (8+ characters).
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
# Browser cross-origin (CORS) allowlist (comma-separated). The built-in UI is same-origin, so leave it empty.
ARTEX_CORS_ORIGINS=

# GitHub repository (owner/name) that one-click updates come from. There is no default: while this and the
# "Update source" field in Settings are both empty, updates are unavailable.
# - Update checks are off until an admin turns them on in Settings; while off, ARTEX never contacts GitHub.
# - The "Update source" field in Settings overrides this value when it is filled in.
# - An invalid value blocks updates.
# - Earlier versions of this code pointed to Autumn-27/ARTEX and jiwoochris/artex-global. Those repositories
#   are outside this project's control, so take precautions before using either as an update source.
ARTEX_UPDATE_REPO=
